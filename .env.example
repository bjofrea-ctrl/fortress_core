DATABASE_URL=postgresql://user:password@db:5432/fortress_db
SECRET_KEY=super-secret-key-change-in-prod
ENVIRONMENT=development

ABSOLUTE_CEILING=0.12
RISK_PER_TRADE=0.015
MAX_POSITION_PCT=0.10
INITIAL_CAPITAL=25000.0
TARGET_VOLATILITY=0.10
VIOLATION_WINDOW_DAYS=60

# NVIDIA NIM (LLM gratuito para agentes avanzados)
# Obtén tu API key gratis en: https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
