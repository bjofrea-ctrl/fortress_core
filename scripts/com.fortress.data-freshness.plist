<?xml version="1.0" encoding="UTF-8"?>
<!--
  TZ-DOC (auditoría 2026-09-07): trigger RELATIVO (cada 3600s) desde RunAtLoad/último disparo.
  Sin hora de pared fija → TZ/DST no aplican al disparo. El dato que procesa puede
  estar en ET/UTC; documentar eso en el script invocado si aplica.
-->

<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fortress.data-freshness</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/boris/Desktop/fortress_core/scripts/check_data_freshness.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/boris/Desktop/fortress_core/logs/data_freshness.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/boris/Desktop/fortress_core/logs/data_freshness.error.log</string>
</dict>
</plist>
