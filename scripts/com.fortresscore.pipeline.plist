<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fortresscore.pipeline</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/boris/Desktop/fortress_core/scripts/daily_signal_pipeline.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <!-- ~09:35 ET: ENTER (primer hábil del mes) -->
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
        <!-- ~15:40 ET: EXIT (último hábil del mes) -->
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>40</integer>
        </dict>
        <!-- ~22:10 ET: DECIDE (último hábil del mes, tras data_updater) -->
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/boris/Desktop/fortress_core/scripts/pipeline_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/boris/Desktop/fortress_core/scripts/pipeline_launchd.log</string>
</dict>
</plist>
