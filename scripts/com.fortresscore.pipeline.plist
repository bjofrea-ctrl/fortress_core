<?xml version="1.0" encoding="UTF-8"?>
<!--
  TZ-DOC (auditoría 2026-09-07): dispara en hora LOCAL del Mac = ART (America/Argentina/Buenos_Aires, UTC-3, SIN DST).
  StartCalendarInterval: 09:35; 15:40; 22:10 ART, todos los días.
  Equivalencia ET (America/New_York, con DST de EE.UU.):
      - 09:35 ART → 07:35 ET (invierno EST) / 08:35 ET (verano EDT)
      - 15:40 ART → 13:40 ET (invierno EST) / 14:40 ET (verano EDT)
      - 22:10 ART → 20:10 ET (invierno EST) / 21:10 ET (verano EDT)
  DST: ART no cambia; la equivalencia ET salta ±1h en la transición de EE.UU.
       (2.º domingo de marzo → 1.º domingo de noviembre). El disparo en pared es
       estable (Mac en ART); solo cambia el significado respecto a ET/mercado US.
-->

<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fortresscore.pipeline</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/boris/Desktop/fortress_core/scripts/daily_signal_pipeline.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <!-- ~09:35 ET: ENTER (primer hábil del mes) -->
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
        <!-- ~15:40 ET: EXIT (último hábil del mes) -->
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>40</integer>
        </dict>
        <!-- ~22:10 ET: DECIDE (último hábil del mes, tras data_updater) -->
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/boris/Desktop/fortress_core/scripts/pipeline_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/boris/Desktop/fortress_core/scripts/pipeline_launchd.log</string>
</dict>
</plist>
